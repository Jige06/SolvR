<?xml version="1.0" encoding="UTF-8"?>
<!-- Configuration des tests automatisés : docker compose exec web composer test -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         cacheDirectory=".phpunit.cache"
         colors="true"
         failOnRisky="true"
         failOnWarning="true"
         beStrictAboutOutputDuringTests="true">
    <testsuites>
        <testsuite name="SolvR">
            <directory>tests</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>

    <php>
        <!-- Les erreurs journalisées par le code (panne SMTP simulée) n'encombrent pas l'affichage -->
        <ini name="error_log" value="/dev/null"/>
    </php>
</phpunit>
