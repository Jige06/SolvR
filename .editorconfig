# Réglages communs à tous les éditeurs (VS Code : extension « EditorConfig for VS Code »)
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown : deux espaces en fin de ligne forcent un retour à la ligne, on les garde
[*.md]
trim_trailing_whitespace = false

# YAML : indentation de 2 espaces par convention
[*.{yml,yaml}]
indent_size = 2
